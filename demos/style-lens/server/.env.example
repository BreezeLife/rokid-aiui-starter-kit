# Keep this file's values blank in source control. Copy to .env for local use.
VISION_API_KEY=
# Choose an available model supporting images in Chat Completions. No default model.
VISION_MODEL=
VISION_API_BASE_URL=https://api.openai.com/v1
# Generate with: node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
# This is a temporary demo credential, never your provider key.
TEAM_TOKEN=
# An ISO timestamp in the future, no more than 24 hours after server startup.
# Example generator: node -e "console.log(new Date(Date.now()+4*60*60*1000).toISOString())"
TEAM_TOKEN_EXPIRES_AT=
HOST=127.0.0.1
PORT=8787
UPSTREAM_TIMEOUT_MS=25000
# Optional exact HTTPS browser preview origin. Empty disables browser cross-origin access.
# Native AIUI requests do not depend on browser CORS. Never use *.
ALLOWED_ORIGIN=
